generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum ProductType {
  GENERIC
  PREDEFINED
  CUSTOM
  COMBO
}

enum ProductStatus {
  HIDDEN
  PUBLISHED
  UNAVAILABLE
}

enum PricingMode {
  FIXED
  QUOTE
}

enum OrderStatus {
  PENDING_CONFIRMATION
  CONFIRMED
  IN_PRODUCTION
  READY
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  DEPOSIT_RECEIVED
  PAID
}

model Administrator {
  id           String         @id @default(cuid())
  email        String         @unique
  name         String
  passwordHash String
  active       Boolean        @default(true)
  sessions     AdminSession[]
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
}

// The cookie will contain an opaque random token; only its hash is stored.
model AdminSession {
  id              String        @id @default(cuid())
  tokenHash       String        @unique
  administratorId String
  administrator   Administrator @relation(fields: [administratorId], references: [id], onDelete: Cascade)
  expiresAt       DateTime
  createdAt       DateTime      @default(now())

  @@index([administratorId])
  @@index([expiresAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String    @unique
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

model Product {
  id            String                 @id @default(cuid())
  slug          String                 @unique
  name          String
  description   String
  type          ProductType
  status        ProductStatus          @default(HIDDEN)
  pricingMode   PricingMode            @default(QUOTE)
  // Integer ARS cents. Null means pending quotation, never zero.
  priceCents    Int?
  measurements  String?
  materials     String?
  includes      String?
  leadTime      String?
  categories    Category[]
  images        ProductImage[]
  variants      ProductVariant[]
  fields        PersonalizationField[]
  components    ComboComponent[]       @relation("ComboOwner")
  usedInCombos  ComboComponent[]       @relation("ComponentProduct")
  orderItems    OrderItem[]
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([status, type])
}

model ProductImage {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  cloudinaryPublicId String   @unique
  url                String
  alt                String?
  // The first image ordered by position is the cover.
  position           Int      @default(0)

  @@index([productId, position])
}

model ProductVariant {
  id                 String   @id @default(cuid())
  productId          String
  product            Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name               String
  additionalCents    Int      @default(0)
  requiresThreePhotos Boolean @default(false)
  active             Boolean  @default(true)

  @@unique([productId, name])
}

model PersonalizationField {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  key       String
  label     String
  required  Boolean  @default(false)
  position  Int      @default(0)

  @@unique([productId, key])
}

model ComboComponent {
  id                 String   @id @default(cuid())
  comboId            String
  combo              Product  @relation("ComboOwner", fields: [comboId], references: [id], onDelete: Cascade)
  componentProductId String?
  componentProduct   Product? @relation("ComponentProduct", fields: [componentProductId], references: [id], onDelete: SetNull)
  name               String
  quantity           Int
  position           Int      @default(0)

  @@index([comboId])
  @@index([componentProductId])
}

model Order {
  id                 String        @id @default(cuid())
  reference          String        @unique
  customerName       String
  customerPhone      String
  requestedDate      DateTime      @db.Date
  deliveryMethod     String
  deliveryAddress    String?
  notes              String?
  knownSubtotalCents Int
  pendingQuoteCount  Int
  shippingCents      Int?
  status             OrderStatus   @default(PENDING_CONFIRMATION)
  paymentStatus      PaymentStatus @default(PENDING)
  items              OrderItem[]
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  @@index([status, createdAt])
}

model OrderItem {
  id                    String      @id @default(cuid())
  orderId               String
  order                 Order       @relation(fields: [orderId], references: [id], onDelete: Restrict)
  productId             String?
  product               Product?    @relation(fields: [productId], references: [id], onDelete: SetNull)
  // Snapshots are independent of subsequent catalog edits.
  productName           String
  variantSnapshot       Json?
  customizationSnapshot Json
  componentsSnapshot    Json?
  pricingMode           PricingMode
  unitPriceCents        Int?
  quantity              Int
  subtotalCents         Int?
  notes                 String?

  @@index([orderId])
  @@index([productId])
}

model StoreSettings {
  id              Int      @id @default(1)
  name            String   @default("Por fin!")
  whatsapp        String?
  instagram       String?
  description     String?
  deliveryMethods String[]
  updatedAt       DateTime @updatedAt
}
