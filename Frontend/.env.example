# Solo el servidor de Next.js lee estas variables. No usar NEXT_PUBLIC_ para secretos.
BACKEND_API_URL=http://127.0.0.1:3001/api/v1
# Debe coincidir con la dirección abierta en el navegador y ALLOWED_ORIGINS de NestJS.
WEB_ORIGIN=http://localhost:3000
NEXT_TELEMETRY_DISABLED=1
# Habilitar solo cuando el dominio público y el contenido estén listos.
SITE_INDEXABLE=false
