NODE_ENV=development
PORT=3001
# Neon: pooled URL for runtime; direct URL for migrations. Production requires sslmode=require&sslaccept=strict on BOTH URLs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/porfin?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/porfin?schema=public
ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
API_ORIGIN=http://localhost:3001
SESSION_TTL_HOURS=8
SESSION_SAME_SITE=lax
# Keep 0 locally. Configure the exact trusted proxy hop count in deployment.
TRUST_PROXY_HOPS=0
# file: local only; resend: HTTPS API; smtp: optional provider; disabled: recovery returns 503.
MAIL_MODE=file
MAIL_OUTBOX_DIR=.local/recovery-outbox
PASSWORD_RESET_URL=http://localhost:3000/admin/reset-password
# Resend: MAIL_MODE=resend. Use a sender on a verified domain.
RESEND_API_KEY=
EMAIL_FROM="Porfin Carteles <no-reply@porfincarteles.com>"
# For SMTP, set MAIL_MODE=smtp and complete all fields below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Production preflight requires Cloudinary and Resend (or SMTP).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
# Google Calendar OAuth. Leave all empty to keep the optional integration disabled.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
# Example: http://localhost:3000/admin/pedidos/google
GOOGLE_CALENDAR_REDIRECT_URL=
# Restrict the connection to the business account, for example porfincarteles@gmail.com
GOOGLE_CALENDAR_ACCOUNT_EMAIL=
# 64 hexadecimal characters. Generate once and keep it secret.
INTEGRATION_ENCRYPTION_KEY=
