NODE_ENV=development
PORT=3001
# Neon: pooled URL for runtime; direct URL for migrations. Production requires sslmode=require&sslaccept=strict on BOTH URLs.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/porfin?schema=public
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/porfin?schema=public
ALLOWED_ORIGINS=http://localhost:3000
SWAGGER_ENABLED=true
API_ORIGIN=http://localhost:3001
SESSION_TTL_HOURS=8
SESSION_SAME_SITE=lax
# Keep 0 locally. Configure the exact trusted proxy hop count in deployment.
TRUST_PROXY_HOPS=0
# file: local development only; smtp: real delivery; disabled: recovery returns 503.
MAIL_MODE=file
MAIL_OUTBOX_DIR=.local/recovery-outbox
PASSWORD_RESET_URL=http://localhost:3000/admin/reset-password
# For SMTP, set MAIL_MODE=smtp and complete all fields below.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
# Complete external providers after the backend stages. Production preflight requires Cloudinary and SMTP.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_UPLOAD_PRESET=
